# Copy to .env on the EC2 instance and fill in. Read by docker-compose.prod.yml.
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=erp

# Secret used to sign JWT access tokens. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The prod stack refuses to start if this is unset.
JWT_SECRET=change-me-to-a-long-random-string

# Public domain for Caddy's automatic HTTPS (Let's Encrypt). Must point (DNS A
# record) at this instance, and ports 80+443 must be open. ACME_EMAIL is used
# for cert expiry notices.
DOMAIN=vestro.dev
ACME_EMAIL=admin@vestro.dev

# Amazon ECR registry — set by the deploy pipeline, but useful for manual runs.
# Format: <account_id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.eu-central-1.amazonaws.com
