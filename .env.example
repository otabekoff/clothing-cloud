# Copy to .env on the EC2 instance and fill in. Read by docker-compose.prod.yml.
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=erp

# Amazon ECR registry — set by the deploy pipeline, but useful for manual runs.
# Format: <account_id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.eu-central-1.amazonaws.com
